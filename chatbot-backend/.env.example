# --- app ---
ENVIRONMENT=local
LOG_LEVEL=INFO

# --- database ---
# Host port for the compose `db` service (container always listens on 5432).
DB_HOST_PORT=5433
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/docs_rag

# --- providers ---
LLM_PROVIDER=anthropic
EMBEDDING_PROVIDER=openai

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Must match vector(N) in migrations/0001_init.sql
EMBEDDING_DIM=1536

# --- langfuse ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000
